# Environments
vaanisetu_env/
venv/
env/
.env

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Models and weights (Too large for git)
models/
*.pt
*.bin
*.onnx
*.safetensors

# Media and cache
tts_cache/
*.wav
*.mp3
*.webm
*.ogg

# Database
vaanisetu_feedback.db
*.sqlite3

# IDEs and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Editor backups and generated demo artifacts
*.bak
*_worksheet.pdf
demo_*.pdf

# Local-only files: kept on disk, never committed
OfficeSetup.exe
CLAUDE_CODE_PROMPT.md
Team_*.pptx
Team_*.pdf
Problem Statement ID*
# Untracked scratch moved into the archive (tracked legacy files there stay tracked)
_archive/scratch/
_archive/frontend_drafts/frontend_v*.html
_archive/frontend_drafts/frontend_old_backup.html
_archive/frontend_drafts/test_card.html

# Runtime outputs
tts_out/
verify_report.txt
/data/
CLAUDE_CODE_PROMPT_ADDENDUM.md
CLAUDE_CODE_MASTER_PROMPT_v2.md
Claude outputs/

# Hub-mode HTTPS keys and certificates (tools/make_cert.py). Never commit.
/certs/

# Local Claude Code preview config
/.claude/

# Content packs are build outputs (tools/build_content_pack.py)
/dist/
# Android build outputs
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk

# The Android test pack needs its few audio clips (tests/test_android_assets.py, PackTest.kt)
!android/app/src/test/resources/pack/audio/*.wav

# B1: Parler pre-rendered audio (large, regenerable)
content_audio/

# sherpa-onnx release AAR (50 MB): tools/android/fetch_sherpa_aar.py
android/app/libs/*.aar
