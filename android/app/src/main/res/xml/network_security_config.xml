<?xml version="1.0" encoding="utf-8"?>
<!-- No plain HTTP anywhere except the in-app server on the tablet itself.
     HTTPS to the hub trusts the hub's CA once the teacher installs it as a user
     certificate (the same /hub-ca.crt the browser uses). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
