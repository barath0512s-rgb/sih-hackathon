{
  "about": "The REST contract frontend.html relies on. Run against the Flask hub by tests/test_contract.py and against the Android in-app server by android/app/src/test (ContractTest.kt) and tools/android/device_contract.py. Cases run in order; `save` keeps a response value for later cases as {name}. Types: str, int, num, bool, list, dict, null, and unions like str|null. `needs` lists engines a case requires beyond the content pack: a server without one must answer that case with status 503 and code engine_not_on_device.",
  "version": 1,
  "not_in_contract_yet": {
    "POST /translate/audio, /translate/audio_stream, /session/response (multipart audio)": "needs a recorded clip; covered by tests/test_api.py on the hub; on the tablet from M3 (ASR on device)",
    "POST /curriculum/import, /curriculum/save": "lesson authoring stays on the hub (WP14); the tablet receives lessons in the content pack",
    "GET /metrics/latency": "hub dashboard only"
  },
  "setup": [
    {"id": "lessons_for_setup", "method": "GET", "path": "/lessons",
     "save": {"grade": "lessons.0.grade", "topic": "lessons.0.topic", "line": "lessons.0.plan.0.hindi"}}
  ],
  "cases": [
    {"id": "config", "method": "GET", "path": "/config", "status": 200,
     "types": {"app_name": "str", "app_name_local": "dict"}},
    {"id": "health", "method": "GET", "path": "/health", "status": 200,
     "types": {"status": "str"}, "equals": {"status": "ok"}},
    {"id": "health_models", "method": "GET", "path": "/health/models", "status": 200,
     "types": {"languages": "dict", "online_dependencies": "list"}},
    {"id": "lessons", "method": "GET", "path": "/lessons", "status": 200,
     "types": {"lessons": "list", "lessons.0.grade": "str", "lessons.0.topic": "str", "lessons.0.title": "str",
               "lessons.0.plan": "list", "lessons.0.plan.0.hindi": "str", "lessons.0.lakshya_ids": "list"}},
    {"id": "flashcards", "method": "GET", "path": "/flashcards", "status": 200,
     "types": {"decks": "list", "decks.0.topic": "str", "decks.0.cards": "list", "decks.0.cards.0.hi": "str",
               "decks.0.cards.0.sat": "str", "decks.0.cards.0.source": "str", "decks.0.cards.0.review_status": "str"}},
    {"id": "session_start", "method": "POST", "path": "/session/start",
     "json": {"grade": "{grade}", "topic": "{topic}"}, "status": 200,
     "types": {"session_id": "str", "title": "str", "total_steps": "int", "step": "dict", "lakshya_ids": "list"},
     "save": {"sid": "session_id"}},
    {"id": "session_start_unknown", "method": "POST", "path": "/session/start",
     "json": {"grade": "9", "topic": "no_such_topic"}, "status": 404, "types": {"error": "str"}},
    {"id": "session_goto", "method": "POST", "path": "/session/goto",
     "json": {"session_id": "{sid}", "step": 0}, "status": 200,
     "types": {"step_index": "int", "total_steps": "int", "step": "dict"}, "equals": {"step_index": 0}},
    {"id": "session_next", "method": "POST", "path": "/session/next",
     "json": {"session_id": "{sid}"}, "status": 200, "types": {"completed": "bool", "session_id": "str"}},
    {"id": "session_next_unknown", "method": "POST", "path": "/session/next",
     "json": {"session_id": "nope"}, "status": 404, "types": {"error": "str"}},
    {"id": "session_response_typed", "method": "POST", "path": "/session/response",
     "json": {"session_id": "{sid}", "step": 0, "response": "कुछ और"}, "status": 200,
     "types": {"signal": "str", "message": "str", "step": "int"}},
    {"id": "session_response_empty_is_red", "method": "POST", "path": "/session/response",
     "json": {"session_id": "{sid}", "step": 0, "response": ""}, "status": 200,
     "types": {"signal": "str"}, "equals": {"signal": "red"}},
    {"id": "session_response_needs_step", "method": "POST", "path": "/session/response",
     "json": {"session_id": "{sid}", "response": "x"}, "status": 400, "types": {"error": "str"}},
    {"id": "translate_lesson_line", "method": "POST", "path": "/translate/text",
     "json": {"text": "{line}", "direction": "hi-to-sat", "mode": "lesson_script", "session_id": "{sid}",
              "device_id": "contract"}, "status": 200,
     "types": {"translated_text": "str", "source": "str", "audio_url": "str|null", "tts_error": "str|null",
               "latency": "dict", "latency.total": "num", "request_id": "str"},
     "save": {"sat": "translated_text", "rid": "request_id"}},
    {"id": "translate_bad_direction", "method": "POST", "path": "/translate/text",
     "json": {"text": "x", "direction": "en-to-fr"}, "status": 400, "types": {"error": "str"}},
    {"id": "translate_new_sentence", "method": "POST", "path": "/translate/text", "needs": ["nmt"],
     "json": {"text": "यह वाक्य किसी पाठ में नहीं है, इसे अभी अनुवाद करना होगा।", "direction": "hi-to-sat"},
     "status": 200, "types": {"translated_text": "str", "source": "str"}},
    {"id": "metrics_client", "method": "POST", "path": "/metrics/client",
     "json": {"request_id": "{rid}", "client_total_ms": 1200, "response_ms": 800}, "status": 200,
     "types": {"status": "str"}},
    {"id": "metrics_client_bad", "method": "POST", "path": "/metrics/client",
     "json": {"request_id": "x"}, "status": 400, "types": {"error": "str"}},
    {"id": "speak_lesson_santali", "method": "POST", "path": "/speak",
     "json": {"text": "{sat}", "lang": "sat"}, "status": 200,
     "types": {"audio_url": "str|null", "tts_error": "str|null"}},
    {"id": "speak_bad", "method": "POST", "path": "/speak", "json": {"text": "", "lang": "sat"}, "status": 400,
     "types": {"error": "str"}},
    {"id": "feedback", "method": "POST", "path": "/feedback",
     "json": {"hindi_text": "{line}", "santali_text": "{sat}", "is_correct": true, "direction": "hi-to-sat"},
     "status": 200, "types": {"status": "str", "reused": "bool"}},
    {"id": "feedback_missing", "method": "POST", "path": "/feedback", "json": {"hindi_text": "x"}, "status": 400,
     "types": {"error": "str"}},
    {"id": "worksheet", "method": "POST", "path": "/worksheet",
     "json": {"session_id": "{sid}", "grade": "{grade}", "topic": "{topic}"}, "status": 200,
     "content_type": "application/pdf"},
    {"id": "session_summary", "method": "POST", "path": "/session/summary",
     "json": {"session_id": "{sid}"}, "status": 200,
     "types": {"lesson_title": "str", "total_steps": "int", "comprehension": "dict",
               "comprehension.score_percent": "int", "comprehension.red": "int"}}
  ]
}
